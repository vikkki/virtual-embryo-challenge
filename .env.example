# Copy to .env and fill in. Create a key at https://virtualembryo.ai/challenge/account/api-keys
# Scopes needed: data:read, quota:read, submissions:read (+ submissions:write for uploads)
VE_CHALLENGE_API_KEY=
VE_API_BASE=https://api.virtualembryo.ai

# Remote GPU box used for training (scripts/remote.sh). Keep the real values only in .env.
VEC_REMOTE=
VEC_REMOTE_PORT=22
VEC_REMOTE_KEY=~/.ssh/id_ed25519
VEC_REMOTE_DIR=/workspace/virtual-embryo-challenge
VEC_REMOTE_VENV=/workspace/venv
